# ------------------------------------------------------------------
# My Team — configuration template
#
# Copy to `.env` (git-ignored) and fill in real values.
# On GitHub, add these under:  Settings -> Secrets and variables -> Actions
#   ->  New repository secret
#
# NEVER commit a filled-in copy of this file.
# ------------------------------------------------------------------

# ---------- Control panel access ----------
# Bootstrap admin password. Used ONLY to create the first `admin` account when
# no accounts exist yet. After that it is not a login.
# Leave unset to disable the control panel: guarded routes return 503.
CONTROL_PANEL_PASSWORD=
# Username for that bootstrap admin (default: admin).
CONTROL_PANEL_ADMIN_USER=admin
# Random string used to sign the session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# ---------- Demo accounts ----------
# Set SEED_DEMO_USERS=true to create `admin`, `operator` and `analyst`
# accounts that all share DEMO_USER_PASSWORD. Remove both before going live.
SEED_DEMO_USERS=false
DEMO_USER_PASSWORD=

# ---------- Notifications ----------
# Master switch. Notifications never send unless this is true.
NOTIFY_ENABLED=false
# Comma-separated: email,whatsapp,webhook
NOTIFY_CHANNELS=email

# E-mail via SMTP (Gmail, Outlook, Yahoo, or your own relay).
# For Gmail use an App Password, not your account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Set false for plain relay that does not support STARTTLS.
SMTP_USE_TLS=true
# Comma-separated list of people who should receive alerts.
ALERT_EMAILS=

# WhatsApp / generic webhook.
# Providers: generic | callmebot | ultramsg
NOTIFY_WEBHOOK_PROVIDER=generic
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_TOKEN=
# International format for callmebot / ultramsg, e.g. 15551234567
NOTIFY_WEBHOOK_PHONE=

# ---------- Escalation thresholds (in BASE_CURRENCY) ----------
# Leads worth at least this much go to a human before any pricing decision.
LEAD_VALUE_THRESHOLD=150000
# Net losses at or above this are treated as accounting anomalies.
ACCOUNTING_ANOMALY_THRESHOLD=50000

# ---------- Currency ----------
# The platform prices and reports in PHP by default.
BASE_CURRENCY=PHP
# Indicative conversion rates, in units of X per 1 PHP. Static on purpose:
# no FX API is called, so the platform stays free and deterministic.
FX_USD=0.0165
FX_EUR=0.0152
FX_GBP=0.0130
FX_JPY=2.55

# ---------- Quotation & payment terms ----------
# Philippine standard output VAT. Prices are VAT-INCLUSIVE, so this is the rate
# embedded in quoted totals (0.12 = 12%).
QUOTE_VAT_RATE=0.12
# How long a quotation stays valid, in days.
QUOTE_VALIDITY_DAYS=30
# Offline / on-premise deployment terms:
#   50% on approval of the quotation, 50% on completion of implementation,
#   plus an annual maintenance retainer billed yearly from go-live.
QUOTE_DOWN_PAYMENT_PCT=50
QUOTE_ON_IMPLEMENTATION_PCT=50
QUOTE_MAINTENANCE_PCT=30
# Accounting AI clears a quote only if the margin is at least this...
QUOTE_MARGIN_FLOOR_PCT=45
# ...and the discount is at most this. Breaching either holds the quote for a
# human decision and the customer is not e-mailed.
QUOTE_DISCOUNT_APPROVAL_PCT=15

# ---------- Storage ----------
# Where leads, escalations and campaign drafts are written.
DATA_DIR=var

# ---------- Background worker (optional) ----------
# If set, the GitHub Actions workflow POSTs here instead of running locally.
# Point it at your deployed instance and add the value as a repository secret.
WORKER_URL=
WORKER_TOKEN=